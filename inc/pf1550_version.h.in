/**
 * @file pf1550_version.h
 * @brief PF1550 driver version, generated by CMake from pf1550_version.h.in.
 * @copyright Copyright (c) 2026 The driver-pf1550 authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/pf1550_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef PF1550_VERSION_H
#define PF1550_VERSION_H

/** Major version: incompatible API changes. */
#define PF1550_VERSION_MAJOR @PF1550_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define PF1550_VERSION_MINOR @PF1550_VERSION_MINOR@
/** Patch version: fixes. */
#define PF1550_VERSION_PATCH @PF1550_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define PF1550_VERSION_STRING "@PF1550_VERSION@"

#endif // PF1550_VERSION_H
